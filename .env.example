NODE_ENV=development
PORT=8080

POSTGRES_PORT=5432
DATABASE_URL=postgresql://architecture_lab:1234@localhost:5432/architecture_lab?schema=market
# Docker Compose 내부 애플리케이션용 override
DOCKER_DATABASE_URL=postgresql://architecture_lab:1234@timescaledb:5432/architecture_lab?schema=market
TWELVE_DATA_API_KEY=replace-with-your-api-key
# TWELVE_DATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price
TWELVE_DATA_WS_URL=ws://host.docker.internal:8081

REDIS_URL=redis://localhost:6379

STREAM_SYMBOLS=BTC/USD
ENABLE_HISTORICAL_BACKFILL=false
LEADER_ELECTION_LOCK_KEY=424242
LEADER_ELECTION_RETRY_MS=1000
ROCKSDB_PATH=./data/rocksdb/candles

KAFKA_BROKERS=localhost:9092
KAFKA_RAW_TICKS_TOPIC=market.raw-ticks
KAFKA_CLIENT_ID=market-feed-ingestor
KAFKA_CANDLE_CONSUMER_GROUP=candle-processor-v1
KAFKA_CANDLE_CONSUMER_CLIENT_ID=candle-processor
CANDLE_PROCESSOR_SYMBOLS=BTC/USD
